exclude src/matrix_oracle/gicforge.py
exclude src/matrix_oracle/guidance.py
exclude src/matrix_oracle/project.py
exclude src/matrix_oracle/publication.py
exclude src/matrix_oracle/qm_jobs.py
exclude src/matrix_oracle/sefit.py
exclude src/matrix_oracle/structure.py
exclude src/matrix_oracle/thermo_kinetics.py
