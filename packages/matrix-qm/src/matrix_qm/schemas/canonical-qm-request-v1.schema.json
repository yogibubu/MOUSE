{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://matrix.local/schemas/canonical-qm-request-v1.schema.json",
  "title": "MATRIX canonical QM request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "level_or_profile",
    "backend",
    "electronic_state",
    "spin",
    "state_root",
    "target_state_spin",
    "charge",
    "multiplicity",
    "atomic_numbers",
    "ecp_mask",
    "derivative",
    "derivative_mode",
    "accelerator",
    "platform",
    "application_domain",
    "single_reference_confirmed",
    "basis_available",
    "basis_source",
    "core_valence_requested",
    "validation_mode"
  ],
  "properties": {
    "schema": {"const": "matrix.qm.canonical_request.v1"},
    "level_or_profile": {"type": "string", "minLength": 1},
    "backend": {"enum": ["xtb", "pyscf", "et", "orca", "psi4"]},
    "electronic_state": {"enum": ["ground", "excited"]},
    "spin": {"enum": ["closed_shell", "open_shell"]},
    "state_root": {"type": ["integer", "null"], "minimum": 0},
    "target_state_spin": {"type": ["string", "null"], "enum": ["singlet", "triplet", null]},
    "charge": {"type": "integer"},
    "multiplicity": {"type": "integer", "minimum": 1},
    "atomic_numbers": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "integer", "minimum": 1, "maximum": 118}
    },
    "ecp_mask": {"type": "array", "items": {"type": "boolean"}},
    "derivative": {"enum": ["energy", "gradient", "hessian"]},
    "derivative_mode": {"type": "string", "minLength": 1},
    "accelerator": {"type": "string", "minLength": 1},
    "platform": {"enum": ["macos-arm64", "macos-x86_64", "linux-x86_64"]},
    "application_domain": {"type": "string", "minLength": 1},
    "single_reference_confirmed": {"type": "boolean"},
    "basis_available": {"type": ["boolean", "null"]},
    "basis_source": {"type": ["string", "null"]},
    "core_valence_requested": {"type": "boolean"},
    "validation_mode": {"type": "boolean"}
  }
}
