    "threads_per_job": "process_count_per_job multiplied by threads_per_process",
    "concurrent_jobs": "number of independent QM points evaluated simultaneously",
    "memory_per_job_gb": "maximum total memory reserved for one QM point, not per process or thread",
    "maximum_memory_gb": "memory_per_job_gb multiplied by concurrent_jobs",
    "resource_change": "requires a new launch plan and explicit authorization"
  },
