{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "matrix.keymaker.five-tool-plan.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "issuer", "access", "workflow", "route", "link_services", "source_artifacts", "manifest_sha256", "readiness_contract_sha256", "excluded_tools", "plan_sha256"],
  "properties": {
    "schema": {"const": "matrix.keymaker.five-tool-plan.v1"},
    "issuer": {"const": "KEYMAKER"},
    "access": {"const": "KEYMAKER_ONLY"},
    "workflow": {"enum": ["minimum", "noncovalent_minimum", "ts_endpoint_pair", "energy_only"]},
    "route": {"const": ["SWITCH", "ORACLE", "SMITH", "LINK"]},
    "link_services": {"const": ["APOC"]},
    "source_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "schema", "owner", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "schema": {"type": "string", "minLength": 1},
          "owner": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "manifest_sha256": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "readiness_contract_sha256": {"type": "object", "minProperties": 5, "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "excluded_tools": {"const": ["ARCHITECT", "TRINITY"]},
    "plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
