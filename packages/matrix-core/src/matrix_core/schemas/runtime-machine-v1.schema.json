{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://matrix.invalid/schema/runtime-machine-v1.schema.json",
  "title": "MATRIX observed runtime machine v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "node_name",
    "hostname",
    "operating_system",
    "operating_system_release",
    "architecture",
    "processor",
    "python_version",
    "python_abi",
    "limits"
  ],
  "properties": {
    "schema": {"const": "matrix.runtime-machine.v1"},
    "node_name": {"type": "string", "minLength": 1},
    "hostname": {"type": "string", "minLength": 1},
    "operating_system": {"type": "string", "minLength": 1},
    "operating_system_release": {"type": "string"},
    "architecture": {"type": "string", "minLength": 1},
    "processor": {"type": "string"},
    "python_version": {"type": "string", "minLength": 1},
    "python_abi": {"type": "string"},
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "processors",
        "memory_gb",
        "gpu_count",
        "neural_engine_count",
        "max_concurrent_jobs"
      ],
      "properties": {
        "processors": {"type": "integer", "minimum": 1},
        "memory_gb": {"type": "number", "exclusiveMinimum": 0},
        "gpu_count": {"type": "integer", "minimum": 0},
        "neural_engine_count": {"type": "integer", "minimum": 0},
        "max_concurrent_jobs": {"type": "integer", "minimum": 1}
      }
    }
  }
}
