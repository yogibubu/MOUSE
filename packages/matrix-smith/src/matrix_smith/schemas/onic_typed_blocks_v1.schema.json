{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://matrix-suite.org/schemas/smith/onic_typed_blocks_v1.schema.json",
  "title": "MATRIX SMITH composite ONIC typed-block contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "orientation",
    "atom_indices_one_based",
    "reference_coordinates_angstrom",
    "reference_fingerprint_sha256",
    "blocks",
    "global_audit",
    "provenance",
    "schema"
  ],
  "properties": {
    "orientation": {"enum": ["TONIC", "CONIC", "SONIC"]},
    "atom_indices_one_based": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 1}
    },
    "reference_coordinates_angstrom": {"$ref": "#/$defs/coordinates"},
    "reference_fingerprint_sha256": {"$ref": "#/$defs/sha256"},
    "blocks": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/block"}
    },
    "global_audit": {"$ref": "#/$defs/globalAudit"},
    "provenance": {"type": "array", "items": {"type": "string"}},
    "schema": {"const": "matrix.smith.onic_typed_blocks.v1"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullableNonnegative": {
      "anyOf": [
        {"type": "number", "minimum": 0},
        {"type": "null"}
      ]
    },
    "coordinates": {
      "type": "array",
      "items": {
        "type": "array",
        "minItems": 3,
        "maxItems": 3,
        "items": {"type": "number"}
      }
    },
    "siteFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "anchor_atom_indices_one_based",
        "origin_angstrom",
        "axes_global",
        "policy",
        "orientation_sign_policy",
        "provenance"
      ],
      "properties": {
        "anchor_atom_indices_one_based": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 1}
        },
        "origin_angstrom": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {"type": "number"}
        },
        "axes_global": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {"type": "number"}
          }
        },
        "policy": {"type": "string", "minLength": 1},
        "orientation_sign_policy": {"type": "string", "minLength": 1},
        "provenance": {"type": "array", "items": {"type": "string"}}
      }
    },
    "sparseEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["row", "column", "value"],
      "properties": {
        "row": {"type": "integer", "minimum": 0},
        "column": {"type": "integer", "minimum": 0},
        "value": {"type": "number"}
      }
    },
    "matrix": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rows", "columns", "storage", "dense_rows", "sparse_entries", "reference"],
      "properties": {
        "rows": {"type": "integer", "minimum": 0},
        "columns": {"type": "integer", "minimum": 0},
        "storage": {
          "enum": [
            "DENSE",
            "SPARSE_COO",
            "IDENTITY",
            "IMPLICIT_FROM_COEFFICIENTS",
            "DELEGATED"
          ]
        },
        "dense_rows": {
          "type": "array",
          "items": {"type": "array", "items": {"type": "number"}}
        },
        "sparse_entries": {
          "type": "array",
          "items": {"$ref": "#/$defs/sparseEntry"}
        },
        "reference": {"type": "string"}
      }
    },
    "symmetryOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "matrix"],
      "properties": {
        "label": {"type": "string", "minLength": 1},
        "matrix": {"$ref": "#/$defs/matrix"}
      }
    },
    "degeneracyGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identifier",
        "irrep",
        "coordinate_identifiers",
        "component_gauge",
        "projector",
        "representation_matrices"
      ],
      "properties": {
        "identifier": {"type": "string", "minLength": 1},
        "irrep": {"type": "string", "minLength": 1},
        "coordinate_identifiers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "component_gauge": {"type": "string", "minLength": 1},
        "projector": {"$ref": "#/$defs/matrix"},
        "representation_matrices": {
          "type": "array",
          "items": {"$ref": "#/$defs/symmetryOperation"}
        }
      }
    },
    "diagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "spectrum",
        "condition_number",
        "projector_symmetry_residual",
        "projector_idempotency_residual",
        "row_space_residual",
        "covariance_residual",
        "validity_radius",
        "singularity_threshold",
        "chirality_policy",
        "messages"
      ],
      "properties": {
        "spectrum": {"type": "array", "items": {"type": "number", "minimum": 0}},
        "condition_number": {"$ref": "#/$defs/nullableNonnegative"},
        "projector_symmetry_residual": {"$ref": "#/$defs/nullableNonnegative"},
        "projector_idempotency_residual": {"$ref": "#/$defs/nullableNonnegative"},
        "row_space_residual": {"$ref": "#/$defs/nullableNonnegative"},
        "covariance_residual": {"$ref": "#/$defs/nullableNonnegative"},
        "validity_radius": {"$ref": "#/$defs/nullableNonnegative"},
        "singularity_threshold": {"$ref": "#/$defs/nullableNonnegative"},
        "chirality_policy": {"type": "string", "minLength": 1},
        "messages": {"type": "array", "items": {"type": "string"}}
      }
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identifier",
        "kind",
        "representation",
        "atom_indices_one_based",
        "atom_indices_zero_based",
        "reference_coordinates_angstrom",
        "reference_fingerprint_sha256",
        "source_family_identifiers",
        "source_order",
        "coordinate_identifiers",
        "target_rank",
        "source_count",
        "nullity",
        "linearity",
        "rank_method",
        "rank_absolute_tolerance",
        "rank_relative_tolerance",
        "coefficient_operator",
        "local_symmetry_provenance",
        "exact_retained_group",
        "irrep_labels",
        "degeneracy_groups",
        "component_gauge",
        "unit",
        "scaling_policy",
        "scale_factors",
        "protected",
        "active",
        "observable",
        "analytic_derivative_status",
        "second_derivative_status",
        "diagnostics",
        "payload_schema",
        "payload_identity_sha256",
        "reference_block_id",
        "moving_block_id",
        "provenance",
        "schema"
      ],
      "properties": {
        "identifier": {"type": "string", "minLength": 1},
        "kind": {"enum": ["SUBSTRATE", "MOLECULE_INTERNAL", "RELATIVE_POSE"]},
        "representation": {
          "enum": [
            "SYMMETRY_ADAPTED_CARTESIAN",
            "INVERSE_DISTANCE_PROJECTOR",
            "NATURAL_INTERNAL",
            "EXPONENTIAL_MAP",
            "PSEUDO_BOND_CONTACT"
          ]
        },
        "atom_indices_one_based": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 1}
        },
        "atom_indices_zero_based": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 0}
        },
        "reference_coordinates_angstrom": {"$ref": "#/$defs/coordinates"},
        "reference_fingerprint_sha256": {"$ref": "#/$defs/sha256"},
        "source_family_identifiers": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "source_order": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "coordinate_identifiers": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "target_rank": {"type": "integer", "minimum": 0},
        "source_count": {"type": "integer", "minimum": 0},
        "nullity": {"type": "integer", "minimum": 0},
        "linearity": {"enum": ["MONATOMIC", "LINEAR", "NONLINEAR", "NOT_APPLICABLE"]},
        "rank_method": {"type": "string", "minLength": 1},
        "rank_absolute_tolerance": {"type": "number", "minimum": 0},
        "rank_relative_tolerance": {"type": "number", "minimum": 0},
        "coefficient_operator": {"$ref": "#/$defs/matrix"},
        "local_symmetry_provenance": {"type": "string", "minLength": 1},
        "exact_retained_group": {"type": "string", "minLength": 1},
        "irrep_labels": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "degeneracy_groups": {
          "type": "array",
          "items": {"$ref": "#/$defs/degeneracyGroup"}
        },
        "component_gauge": {"type": "string", "minLength": 1},
        "unit": {"type": "string", "minLength": 1},
        "scaling_policy": {"type": "string", "minLength": 1},
        "scale_factors": {
          "type": "array",
          "items": {"type": "number", "exclusiveMinimum": 0}
        },
        "protected": {"type": "boolean"},
        "active": {"type": "boolean"},
        "observable": {"type": "boolean"},
        "analytic_derivative_status": {
          "enum": ["ANALYTIC_FIRST_ORDER", "DECLARED", "UNAVAILABLE"]
        },
        "second_derivative_status": {
          "enum": ["GENERAL_SPARSE_B_PRIME", "DEFERRED_B_PRIME", "UNAVAILABLE"]
        },
        "diagnostics": {"$ref": "#/$defs/diagnostics"},
        "site_frame": {
          "anyOf": [
            {"$ref": "#/$defs/siteFrame"},
            {"type": "null"}
          ]
        },
        "payload_schema": {"type": "string"},
        "payload_identity_sha256": {
          "anyOf": [
            {"$ref": "#/$defs/sha256"},
            {"const": ""}
          ]
        },
        "reference_block_id": {"type": "string"},
        "moving_block_id": {"type": "string"},
        "provenance": {"type": "array", "items": {"type": "string"}},
        "schema": {"const": "matrix.smith.onic_typed_blocks.v1"}
      }
    },
    "globalAudit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "cartesian_dimension",
        "external_mode_count",
        "target_rank",
        "evaluated_rank",
        "nullity",
        "covariance_residual",
        "condition_number",
        "rigid_mode_policy",
        "messages"
      ],
      "properties": {
        "status": {"enum": ["PENDING", "PASS", "FAIL"]},
        "cartesian_dimension": {"type": "integer", "minimum": 0},
        "external_mode_count": {"type": "integer", "minimum": 0},
        "target_rank": {"type": "integer", "minimum": 0},
        "evaluated_rank": {
          "anyOf": [
            {"type": "integer", "minimum": 0},
            {"type": "null"}
          ]
        },
        "nullity": {
          "anyOf": [
            {"type": "integer", "minimum": 0},
            {"type": "null"}
          ]
        },
        "covariance_residual": {"$ref": "#/$defs/nullableNonnegative"},
        "condition_number": {"$ref": "#/$defs/nullableNonnegative"},
        "rigid_mode_policy": {"const": "REMOVED_EXACTLY_ONCE"},
        "messages": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
