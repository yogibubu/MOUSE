{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://matrix-suite.org/schemas/smith/sonic_diagnostics_v2.schema.json",
  "title": "SMITH SONIC diagnostics manifest v2",
  "type": "object",
  "required": [
    "schema",
    "source_xyzin",
    "coordinate_count",
    "total_coordinate_count",
    "motion_model",
    "cartesian_metric",
    "mass_source_requested",
    "mass_source_resolved",
    "mass_source_detail",
    "masses_amu",
    "isotope_mass_numbers",
    "topology_validation",
    "full_topology_check_count",
    "coordinates"
  ],
  "properties": {
    "schema": {"const": "matrix.smith.sonic_diagnostics.v2"},
    "source_xyzin": {"type": "string"},
    "coordinate_count": {"type": "integer", "minimum": 0},
    "total_coordinate_count": {"type": "integer", "minimum": 0},
    "motion_model": {"const": "CONSTANT_REFERENCE_B_PSEUDOINVERSE"},
    "cartesian_metric": {"enum": ["euclidean", "mass-weighted"]},
    "mass_source_requested": {"type": "string"},
    "mass_source_resolved": {"type": "string"},
    "mass_source_detail": {"type": "string"},
    "masses_amu": {
      "type": "array",
      "items": {"type": "number", "exclusiveMinimum": 0}
    },
    "isotope_mass_numbers": {
      "type": "array",
      "items": {"type": "integer", "minimum": 1}
    },
    "topology_validation": {"const": "FULL_ORACLE_PER_ACCEPTED_FRAME"},
    "topology_workers_requested": {
      "anyOf": [
        {"const": "auto"},
        {"type": "integer", "minimum": 0}
      ]
    },
    "topology_workers_used": {"type": "integer", "minimum": 0},
    "topology_parallel_backend": {"enum": ["CACHE_ONLY", "SERIAL", "PROCESS_POOL"]},
    "topology_cache_enabled": {"type": "boolean"},
    "topology_cache_path": {"type": "string"},
    "topology_cache_fingerprint": {"type": "string"},
    "topology_cache_hits": {"type": "integer", "minimum": 0},
    "topology_cache_misses": {"type": "integer", "minimum": 0},
    "topology_checks_executed": {"type": "integer", "minimum": 0},
    "topology_checks_reused": {"type": "integer", "minimum": 0},
    "full_topology_check_count": {"type": "integer", "minimum": 0},
    "coordinates": {
      "type": "array",
      "items": {"$ref": "#/$defs/coordinate"}
    }
  },
  "$defs": {
    "coordinate": {
      "type": "object",
      "required": [
        "index",
        "identifier",
        "name",
        "family",
        "irrep",
        "unit",
        "step",
        "status",
        "trajectory",
        "vector",
        "local_domain",
        "local_group",
        "local_irrep",
        "locally_totally_symmetric",
        "globally_totally_symmetric",
        "full_topology_checks"
      ],
      "properties": {
        "index": {"type": "integer", "minimum": 1},
        "identifier": {"type": "string"},
        "name": {"type": "string"},
        "family": {"type": "string"},
        "irrep": {"type": "string"},
        "unit": {"enum": ["angstrom", "radian"]},
        "step": {"type": "number", "exclusiveMinimum": 0},
        "status": {"type": "string"},
        "trajectory": {"type": "string"},
        "vector": {"type": "string"},
        "local_domain": {"type": "string"},
        "local_group": {"type": "string"},
        "local_irrep": {"type": "string"},
        "locally_totally_symmetric": {"type": "boolean"},
        "globally_totally_symmetric": {"type": "boolean"},
        "full_topology_checks": {"type": "integer", "minimum": 2}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
