   symmetry="A'"
  td=mf.TDA();td.wfnsym=symmetry;td.nstates=max(2,row['ordinal_same_symmetry']+1);td.conv_tol=1e-7;td.max_cycle=150;td.lindep=1e-20;started=time.monotonic();td.kernel()
